STOCKFISH_PATH=stockfish

# temps de reflexion du moteur par coup, en secondes
THINK_TIME=3.0

# nombre de threads utilises par Stockfish. Laisse vide pour auto (nb de coeurs - 1).
# SF_THREADS=4

SF_HASH_MB=256

# profondeur de recherche minimale garantie (laisse vide = pas de limite)
# SF_DEPTH=20

# tables de finales Syzygy (optionnel)
# SF_SYZYGY_PATH=/chemin/vers/syzygy

# cle secrete que Roblox doit envoyer dans le header X-API-Key.
# Obligatoire en production : sans elle, n'importe qui sur internet peut
# utiliser ton serveur (et donc ton temps de calcul Stockfish).
API_KEY=change_moi

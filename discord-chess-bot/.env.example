DISCORD_TOKEN=your_discord_bot_token_here
STOCKFISH_PATH=stockfish

# temps de reflexion du moteur par coup, en secondes (force maximale, pas de handicap)
THINK_TIME=3.0

# nombre de threads utilises par Stockfish. Laisse vide pour auto (nb de coeurs - 1).
# SF_THREADS=4

# taille de la table de transposition, en Mo. Plus c'est grand, moins le moteur recalcule.
SF_HASH_MB=256

# profondeur de recherche minimale garantie, en plus du temps (laisse vide = pas de limite)
# SF_DEPTH=20

# chemin vers des tables de finales Syzygy pour un jeu de finale parfait (optionnel)
# SF_SYZYGY_PATH=/chemin/vers/syzygy

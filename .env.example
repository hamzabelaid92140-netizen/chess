# Copie ce fichier en ".env" pour le développement local (vercel dev),
# et renseigne les mêmes variables dans Vercel → Project → Settings → Environment Variables
# pour la production. Ne commite jamais le fichier ".env" réel (déjà exclu via .gitignore).

# --- Stripe (paiement) ---
# Dashboard Stripe → Développeurs → Clés API
STRIPE_SECRET_KEY=sk_test_...
# Dashboard Stripe → Développeurs → Webhooks → (après création du endpoint) → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Supabase (base de données commandes) ---
# Dashboard Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Attention : la clé "service_role" (jamais la clé "anon"), elle ne doit
# jamais être exposée côté navigateur — seules les fonctions /api l'utilisent.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Tableau de bord admin (admin.html) ---
# Choisis une valeur longue et aléatoire (ex: générée avec `openssl rand -hex 24`)
ADMIN_TOKEN=change-moi-en-valeur-longue-et-aleatoire

# --- CJ Dropshipping (optionnel — fulfillment automatique) ---
# Sans ces deux variables, le bouton "Envoyer à CJ" du tableau de bord
# admin échoue proprement et les commandes restent traitables à la main.
# CJ → Mon compte → Clé API ("Get API Key" dans l'onglet API)
CJ_EMAIL=ton-email@example.com
CJ_API_KEY=CJ...
